# Copy to deploy/.env and fill in. Never commit the real file.
DOMAIN=ozymandosis.com
ACME_EMAIL=you@example.com
PUBLIC_IP=203.0.113.10          # the VPS public IPv4 (TURN advertises it)

# openssl rand -base64 32   (each one separately). Keep a copy of SECRET_KEY in your
# password manager: without it, two-factor secrets and ticket keys cannot be read.
SECRET_KEY=
SECRET_KEY_PREVIOUS=            # only during a key rotation (docs/OPERATIONS.md)
POSTGRES_PASSWORD=
TURN_SECRET=

# Email (any SMTP provider: Postmark, SES, Mailgun, Fastmail…)
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=Ozymandosis <no-reply@ozymandosis.com>

# Stripe: dashboard → Developers. Webhook endpoint: https://play.ozymandosis.com/api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=                # optional: found by lookup key after `npm run admin -- stripe:setup`

# Sign-in providers (leave blank to hide a provider). Redirect URI for each:
#   https://play.ozymandosis.com/auth/<google|apple>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=                # the Services ID, e.g. com.ozymandosis.signin
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=              # contents of the .p8 key, newlines as \n
STEAM_API_KEY=                  # optional for web sign-in (adds persona names); required with STEAM_APP_ID for native tickets
STEAM_APP_ID=

# Backups (docs/OPERATIONS.md). age-keygen -o ozymandosis-backup.key on YOUR computer;
# put the public key (age1...) here and keep the key file offline.
BACKUP_AGE_RECIPIENT=
# Linode Object Storage: create a bucket and an access key limited to it
LINODE_S3_ENDPOINT=us-east-1.linodeobjects.com
LINODE_S3_ACCESS_KEY=
LINODE_S3_SECRET_KEY=
BACKUP_REMOTE=linode:ozymandosis-backups/db
BACKUP_PING_URL=                # e.g. https://hc-ping.com/<uuid> (alerts you if backups stop)

# Alerts: email and/or a Discord/Slack incoming webhook
ALERT_EMAIL=
ALERT_WEBHOOK_URL=
METRICS_TOKEN=                  # optional: 24+ characters to enable /metrics for a scraper

# Optional
STRIPE_PRICE_ID_YEARLY=         # the yearly plan (npm run admin -- stripe:setup 1200 creates it at $12)
STRIPE_TAX=true                 # Stripe Tax at checkout (activate it in the Stripe dashboard)
# Google Play Billing for the Android subscription (docs/RELEASE-ANDROID.md, "Play Billing")
GOOGLE_PLAY_SERVICE_ACCOUNT=     # the service account's JSON key, base64
GOOGLE_PLAY_RTDN_TOKEN=          # 24+ random characters; the Pub/Sub push URL ends ?token=<this>
TURNSTILE_SECRET=               # Cloudflare Turnstile on sign-up
FREE_MATCH_MINUTES=15
MIN_CLIENT_VERSION=0.5.0
LOG_LEVEL=info
