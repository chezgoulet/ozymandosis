{
  "name": "@ozymandosis/desktop",
  "version": "0.5.0",
  "private": true,
  "description": "Desktop shell for Windows, macOS and Linux (the Steam build's base). Launches fullscreen. Not an npm workspace: install it separately so the server and CI never download Electron.",
  "main": "main.cjs",
  "scripts": {
    "web": "node ../../tools/build-web.cjs && node -e \"const fs=require('fs');fs.rmSync('web',{recursive:true,force:true});fs.cpSync('../../www','web',{recursive:true});fs.mkdirSync('lan',{recursive:true});fs.copyFileSync('../../server/signal.cjs','lan/signal.cjs')\"",
    "start": "npm run web && electron .",
    "package": "npm run web && electron-builder --dir"
  },
  "dependencies": {
    "bonjour-service": "1.4.4"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.ozymandosis.game",
    "productName": "Ozymandosis",
    "files": ["main.cjs", "preload.cjs", "lan.cjs", "lan/**", "web/**"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.strategy-games" },
    "linux": { "target": "dir", "executableName": "ozymandosis", "category": "Game" }
  }
}
